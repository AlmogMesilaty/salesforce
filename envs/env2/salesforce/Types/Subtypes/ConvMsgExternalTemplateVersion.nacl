type salesforce.ConvMsgExternalTemplateVersion {
  annotations {
    serviceid metadataType {
    }
    boolean hasMetaFile {
    }
    string folderType {
    }
    string folderContentType {
    }
    string suffix {
    }
    string dirName {
    }
  }
  string accountIdentifier {
  }
  string accountName {
  }
  string errorCode {
    _restriction = {
      enforce_value = false
      values = [
        "DeprecationError",
        "IntegrityError",
        "InternalError",
        "InvalidAccessToken",
        "InvalidParameter",
        "MetricsThresholdNotReached",
        "Other",
        "PublishError",
        "ValidationError",
      ]
    }
  }
  string errorMessage {
  }
  string externalConfigJson {
  }
  string language {
  }
  string layoutJson {
  }
  string rejectionReason {
    _restriction = {
      enforce_value = false
      values = [
        "AbusiveContent",
        "IncorrectCategory",
        "InvalidFormat",
        "Other",
        "Scam",
      ]
    }
  }
  string status {
    _restriction = {
      enforce_value = false
      values = [
        "Approved",
        "Deleted",
        "Disabled",
        "InAppeal",
        "LimitExceeded",
        "Paused",
        "Pending",
        "PendingDeletion",
        "Rejected",
      ]
    }
  }
  string templateName {
  }
  string templateVersionIdentifier {
  }
  metadataType = "ConvMsgExternalTemplateVersion"
  _important_values = [
    {
      value = "status"
      highlighted = true
      indexed = true
    },
  ]
  string type {
    _restriction = {
      enforce_value = false
      values = [
        "Flow",
        "Legacy",
        "Template",
      ]
    }
  }
}
