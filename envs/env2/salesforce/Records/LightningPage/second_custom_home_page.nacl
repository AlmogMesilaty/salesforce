salesforce.LightningPage second_custom_home_page {
  flexiPageRegions = [
    {
      itemInstances = [
        {
          componentInstance = {
            componentInstanceProperties = [
              {
                name = "decorate"
                value = "true"
              },
              {
                name = "richTextValue"
                value = "<p>Second custom home page added as org default</p>"
              },
            ]
            componentName = "flexipage:richText"
            identifier = "flexipage_richText"
          }
        },
      ]
      name = "main"
      type = "Region"
    },
  ]
  masterLabel = "second_custom_home_page"
  template = {
    name = "industries_common:homeTemplateOneRegion"
  }
  type = "HomePage"
  fullName = "second_custom_home_page"
  _alias = "second_custom_home_page"
}
